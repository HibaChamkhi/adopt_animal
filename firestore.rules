rules_version = '2';

// Security rules for the adopt_animal Firestore backend.
// Deploy with:  firebase deploy --only firestore:rules
// (or paste into Firebase Console -> Firestore Database -> Rules)

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- helpers ----
    function isSignedIn() {
      return request.auth != null;
    }
    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function userRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : 'guest';
    }
    function isAdmin() {
      return userRole() == 'admin';
    }
    // Only allow the listed fields to be written.
    function onlyFields(allowed) {
      return request.resource.data.keys().hasOnly(allowed);
    }

    // ---- users ----
    // Anyone signed in can read basic profiles (needed to show owner/vet info);
    // a user may only create/update their own document, and never escalate role.
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isSelf(uid)
                    && request.resource.data.role in ['adopter', 'vet'];
      allow update: if isSelf(uid)
                    && request.resource.data.role == resource.data.role; // no self role-change
      allow delete: if isSelf(uid) || isAdmin();

      // users/{uid}/favorites/{animalId}
      match /favorites/{animalId} {
        allow read, write: if isSelf(uid);
      }
      // users/{uid}/cart/{itemId}
      match /cart/{itemId} {
        allow read, write: if isSelf(uid);
      }
    }

    // ---- animals (adoption listings) ----
    match /animals/{animalId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
    }

    // ---- adoption requests ----
    // Adopter creates; both the adopter and the animal owner can read;
    // only the owner can update status (accept / decline).
    match /adoption_requests/{reqId} {
      allow create: if isSignedIn()
                    && request.resource.data.adopterId == request.auth.uid;
      allow read: if isSignedIn()
                    && (resource.data.adopterId == request.auth.uid
                        || resource.data.ownerId == request.auth.uid);
      allow update: if isSignedIn()
                    && resource.data.ownerId == request.auth.uid;
      allow delete: if isSignedIn()
                    && resource.data.adopterId == request.auth.uid;
    }

    // ---- shop products (catalog is admin-managed, readable by all users) ----
    match /products/{productId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- orders ----
    match /orders/{orderId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read: if isSignedIn()
                    && (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if isAdmin(); // status transitions handled server/admin side
      allow delete: if false;
    }

    // ---- vets (directory) ----
    match /vets/{vetId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                    && (request.auth.uid == vetId || isAdmin());
      allow delete: if isAdmin();
    }

    // ---- appointments ----
    match /appointments/{apptId} {
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow read, update: if isSignedIn()
                    && (resource.data.userId == request.auth.uid
                        || resource.data.vetId == request.auth.uid);
      allow delete: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
    }

    // ---- chats + messages ----
    // A chat doc carries participants: [uidA, uidB].
    match /chats/{chatId} {
      allow read, create, update: if isSignedIn()
                    && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in
                       get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn()
                    && request.resource.data.senderId == request.auth.uid
                    && request.auth.uid in
                       get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
      }
    }
  }
}
